{
  "manifest_version": 3,
  "name": "Unified Inbox for Gmail",
  "short_name": "Unified Inbox",
  "description": "Every Gmail account in one inbox — built right into Gmail. No new app to learn.",
  "version": "2.0.0",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "Unified Inbox for Gmail"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content/inject.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "identity",
    "storage",
    "alarms",
    "unlimitedStorage",
    "notifications"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://gmail.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src data: https://gmail.googleapis.com https://www.googleapis.com https://oauth2.googleapis.com https://accounts.google.com"
  }
}
